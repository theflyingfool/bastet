filters:
  and:
    - file.inFolder("hardware")
views:
  - type: table
    name: "A hasLink(this.file)"
    filters:
      and:
        - file.hasLink(this.file)
    order: [file.name, serial, size, status]
  - type: table
    name: "B installed_in == this"
    filters:
      and:
        - installed_in == this
    order: [file.name, serial, size, status]
  - type: table
    name: "C installed_in == this.file.asLink()"
    filters:
      and:
        - installed_in == this.file.asLink()
    order: [file.name, serial, size, status]

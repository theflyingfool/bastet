{%- set version = dns.get("version") if dns.get("version") is not none else "latest" -%}
#!/bin/sh
# Managed by Bastet (the caddy role); changes made here are overwritten.
# Builds /usr/local/bin/caddy-bastet: the packaged Caddy version with the {{ dns.provider }} DNS plugin.
#   build    run by caddy-bastet-build.service as a throwaway user: xcaddy build into the unit's runtime directory
#   install  run by the same unit with full privileges: validate the new binary, move it into place, restart Caddy
#   current  exit 0 when the installed binary has the packaged Caddy version and the wanted plugin version
#   rebuild  reload systemd and run the build unit now
set -eu

MODULE=github.com/caddy-dns/{{ dns.provider }}
ID=dns.providers.{{ dns.provider }}
PIN='{{ version if version != "latest" else "" }}'
BIN=/usr/local/bin/caddy-bastet
RUN=/run/caddy-bastet
STAMP=/usr/local/share/caddy-bastet.build

# The plugin's code runs whenever the binary does, so everything here that runs it does so as the caddy user, never as root.
as_caddy() {
	runuser -u caddy -- "$@"
}

# The plugin release this host should have: the pin, or the newest one Go's module proxy knows.
want() {
	if [ -n "$PIN" ]; then
		echo "$PIN"
		return
	fi
	tmp=$(mktemp -d)
	GOPATH=$tmp GOCACHE=$tmp/cache GOFLAGS=-modcacherw GOTOOLCHAIN=local go list -m -json "$MODULE@latest" 2>/dev/null |
		sed -n 's/.*"Version": "\(.*\)",/\1/p' || true
	rm -rf "$tmp"
}

current() {
	[ -x "$BIN" ] || return 1
	[ "$(as_caddy "$BIN" version 2>/dev/null | cut -d' ' -f1)" = "$(caddy version 2>/dev/null | cut -d' ' -f1)" ] || return 1
	have=$(as_caddy "$BIN" list-modules --versions 2>/dev/null | awk -v id="$ID" '$1 == id { print $2 }')
	[ -n "$have" ] || return 1
	need=$(want)
	if [ -z "$need" ]; then # the module proxy could not be reached: a healthy host must not fail over that, keep what is built
		echo "caddy-bastet: could not look up the newest $ID release; keeping $have" >&2
		return 0
	fi
	[ "$have" = "$need" ]
}

build() {
	go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest
	echo "xcaddy $("$GOBIN/xcaddy" version)"
	with=$MODULE
	[ -z "$PIN" ] || with=$MODULE@$PIN
	"$GOBIN/xcaddy" build "$(caddy version | cut -d' ' -f1)" --with "$with" --output "$RUN/new"
}

install_new() {
	new=$RUN/new
	chmod 0755 "$new"
	as_caddy env XDG_DATA_HOME=/var/lib XDG_CONFIG_HOME=/etc "$new" validate --adapter caddyfile --config /etc/caddy/Caddyfile
	cp "$new" "$BIN.new"
	chmod 0755 "$BIN.new"
	mv -f "$BIN.new" "$BIN"
	mkdir -p "$(dirname "$STAMP")"
	{
		date -u +"built %Y-%m-%dT%H:%M:%SZ"
		echo "caddy $(as_caddy "$BIN" version | cut -d' ' -f1)"
		as_caddy "$BIN" list-modules --versions | awk -v id="$ID" '$1 == id { print "plugin " $1 " " $2 }'
		go version -m "$BIN" | head -n 1 | sed 's/^[^:]*: /go /'
	} >"$STAMP"
	cat "$STAMP"
	if systemctl is-active --quiet caddy.service; then
		systemctl try-restart caddy.service
	fi
}

case "${1:-}" in
build) build ;;
install) install_new ;;
current) current ;;
rebuild)
	systemctl daemon-reload
	systemctl start caddy-bastet-build.service
	;;
*)
	echo "usage: $0 build|install|current|rebuild" >&2
	exit 2
	;;
esac

{%- macro q(text) -%}"{{ text | replace("\\", "\\\\") | replace("\"", "\\\"") }}"{%- endmacro -%}
{%- set upstream = item.get("upstream") -%}
{%- set upstreams = [] if not upstream else ([upstream] if upstream is string else upstream) -%}
{%- set headers = item.get("headers") or {} -%}
{%- set skip_verify = item.get("tls_skip_verify") is true -%}
# Managed by Bastet (the caddy role); changes made here are overwritten.
{{ item.name }} {
{%- if item.get("allow") %}
	@denied not remote_ip {{ item.allow | join(" ") }}
	respond @denied 403
{%- endif %}
{%- if item.get("encode") is true %}
	encode zstd gzip
{%- endif %}
{%- if upstreams and (skip_verify or headers) %}
	reverse_proxy {{ upstreams | join(" ") }} {
{%- if skip_verify %}
		transport http {
			tls_insecure_skip_verify
		}
{%- endif %}
{%- for name, value in headers.items() %}
		header_up {{ q(name) }} {{ q(value) }}
{%- endfor %}
	}
{%- elif upstreams %}
	reverse_proxy {{ upstreams | join(" ") }}
{%- endif %}
{%- if item.get("extra") is not none and item.extra.strip() %}
{{ item.extra.strip("\n") | indent("\t", true) }}
{%- endif %}
}
